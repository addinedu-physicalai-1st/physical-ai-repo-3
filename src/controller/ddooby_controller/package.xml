<?xml version="1.0"?>
<package format="3">
  <name>ddooby_controller</name>
  <version>0.0.0</version>
  <description>DDooby beverage controller package for OpenArm simulation.</description>
  <maintainer email="placeholder@example.com">DDooby Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>control_msgs</depend>
  <depend>custom_msg</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>gz_msgs_vendor</depend>
  <depend>gz_transport_vendor</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>openarm_bimanual_moveit_config</exec_depend>
  <exec_depend>openarm_gazebo</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
