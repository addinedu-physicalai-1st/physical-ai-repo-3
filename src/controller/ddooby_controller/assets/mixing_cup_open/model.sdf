          <iyy>0.00018</iyy>
          <izz>0.00011</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="cup_body_visual">
        <geometry>
          <cylinder>
            <radius>0.036</radius>
            <length>0.110</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.92 0.92 0.92 0.38</ambient>
          <diffuse>0.92 0.92 0.92 0.38</diffuse>
        </material>
      </visual>

      <visual name="cup_bottom_visual">
        <pose>0 0 -0.052 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.006</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.92 0.92 0.92 0.85</ambient>
          <diffuse>0.92 0.92 0.92 0.85</diffuse>
        </material>
      </visual>

      <visual name="liquid_marker">
