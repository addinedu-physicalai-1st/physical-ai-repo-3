# 테이블 점유 현황 조회 — task_orchestrator 의 table cache 조회
# 서버: task_orchestrator
# 클라이언트: (선택) CLI/스크립트, mode 외부 트리거 노드
#
# /patrol/table_report 로 갱신된 최신 캐시를 ROS 도메인에서 조회한다.

string table_id           # 비우면 전체 반환 ("T01"~"T05" 또는 "")
---
bool success
string status_json        # JSON 배열 또는 단일 객체
                          # 예: [{"id":"T01","occupancy":"occupied","person_count":2,
                          #       "confidence":0.91,"last_update":"2026-05-16T12:30:01Z",
                          #       "dishes_detected":false}, ...]
