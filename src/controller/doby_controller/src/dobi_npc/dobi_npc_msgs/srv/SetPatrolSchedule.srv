# 순회 스케줄 설정 — moca_opserver 의 patrol_scheduler 정책 갱신
# 서버: moca_opserver_node
# 클라이언트: 웹 UI(POST /api/v1/config 경유 또는 ROS 직접), CLI 스크립트
#
# REST API 의 POST /api/v1/config 와 동일 효과. opserver_config.yaml 디스크 저장 + 즉시 반영.
# 본 srv 는 ROS 도메인에서 사용. 웹은 보통 REST 사용.

float32 interval_minutes  # 자동 patrol 주기 (기본 5.0)
bool enabled              # false 면 자동 patrol 차단 (수동 호출은 가능)
string active_hours       # 영업시간 "HH:MM-HH:MM" (예: "09:00-22:00"). 빈 문자열이면 24시간.
---
bool success
string reason             # 거부/실패 사유 (success=false 시) 또는 ""
