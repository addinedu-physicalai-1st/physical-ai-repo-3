# 순회 스케줄 설정 — task_orchestrator 의 idle patrol 정책 갱신
# 서버: task_orchestrator
# 클라이언트: ROS 운영 도구, CLI 스크립트
#
# HTTP/REST 저장 없이 런타임 스케줄만 즉시 반영한다.

float32 interval_minutes  # 자동 patrol 주기 (기본 5.0)
bool enabled              # false 면 자동 patrol 차단 (수동 호출은 가능)
string active_hours       # 영업시간 "HH:MM-HH:MM" (예: "09:00-22:00"). 빈 문자열이면 24시간.
---
bool success
string reason             # 거부/실패 사유 (success=false 시) 또는 ""
