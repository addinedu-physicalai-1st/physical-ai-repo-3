<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moca_navigation</name>
  <version>0.1.0</version>
  <description>moca Nav2 stack (vicpinky_navigation copy + R2 patch + mapv5 default map). PinkLAB vicpinky_navigation is frozen.</description>
  <maintainer email="kong@pinklab.art">Stephen Kong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>navigation2</depend>
  <depend>nav2_bringup</depend>
  <depend>nav2_velocity_smoother</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
