<?xml version='1.0'?>
<!--
  moca_navigation/launch/bringup_launch.xml
  Source: vicpinky_navigation/launch/bringup_launch.xml (PinkLAB 원본 동결, 사본 + patch)

  변경 (2026-05-14):
   - find-pkg-share vicpinky_navigation → moca_navigation (자체 참조)
   - map default → env MOCA_MAP_PATH > workspace_root/maps/mapv5.yaml (실측 SoT, 절대경로 회피)
   - lifecycle_nodes_nav 의 velocity_smoother → nav2_velocity_smoother (R2 patch — RPi 측 동일 이름 노드와의 DDS 충돌 회피)
   - vicpinky_navigation 원본 미수정

  검증 시동 (PC 단독, 시뮬 도메인):
    ROS_DOMAIN_ID=99 ROS_LOCALHOST_ONLY=1 ros2 launch moca_navigation bringup_launch.xml
-->
<launch>
    <set_env name="RCUTILS_LOGGING_BUFFERED_STREAM" value="1"/>

    <arg name="namespace" default=""/>
    <!-- map default: 환경변수 MOCA_MAP_PATH 우선, 미설정 시 워크스페이스 루트의 maps/mapv5.yaml.
         find-pkg-share moca_navigation = install/moca_navigation/share/moca_navigation
         .../../../ 거슬러 워크스페이스 루트 → maps/mapv5.yaml.
         협업자는 ros2 launch ... map:=<path> 또는 export MOCA_MAP_PATH=... 로 override. -->
    <arg name="map" default="$(env MOCA_MAP_PATH $(find-pkg-share moca_navigation)/../../../maps/mapv5.yaml)"/>
    <arg name="use_sim_time" default="False"/>
    <arg name="params_file" default="$(find-pkg-share moca_navigation)/params/nav2_params.yaml"/>
    <arg name="autostart" default="True"/>
    <arg name="container_name" default="nav2_container"/>
    <arg name="use_composition" default="True"/>
    <arg name="use_respawn" default="False"/>
    <arg name="log_level" default="info"/>
    <arg name="lifecycle_nodes_local" default="['map_server', 'amcl']"/>
    <arg name="lifecycle_nodes_nav" default="['controller_server',
                       'planner_server',
                       'behavior_server',
                       'bt_navigator',
                       'waypoint_follower',
                       'nav2_velocity_smoother']"/>

    <group>
        <push-ros-namespace namespace="$(var namespace)"/>
        <node pkg="rclcpp_components" exec="component_container_isolated" name='$(var container_name)' output="screen" args="--ros-args --log-level $(var log_level)">
            <param from="$(var params_file)"/>
            <param name='map' value="$(var map)"/>
            <param name='autostart' value="$(var autostart)"/>
            <param name='use_sim_time' value="$(var use_sim_time)"/>

            <remap from="/tf" to="tf"/>
            <remap from="/tf_static" to="tf_static"/>
        </node>

        <include file="$(find-pkg-share moca_navigation)/launch/localization_launch.xml">
            <arg name="params_file" value="$(var params_file)"/>
            <arg name="map" value="$(var map)"/>
            <arg name="use_sim_time" value="$(var use_sim_time)"/>
            <arg name="autostart" value="$(var autostart)"/>
            <arg name="use_composition" value="$(var use_composition)"/>
            <arg name="use_respawn" value="$(var use_respawn)"/>
            <arg name="container_name" value="$(var container_name)"/>
            <arg name='lifecycle_nodes' value="$(var lifecycle_nodes_local)"/>
        </include>

        <include file="$(find-pkg-share moca_navigation)/launch/navigation_launch.xml">
            <arg name="params_file" value="$(var params_file)"/>
            <arg name="use_sim_time" value="$(var use_sim_time)"/>
            <arg name="autostart" value="$(var autostart)"/>
            <arg name="use_composition" value="$(var use_composition)"/>
            <arg name="use_respawn" value="$(var use_respawn)"/>
            <arg name="container_name" value="$(var container_name)"/>
            <arg name='lifecycle_nodes' value="$(var lifecycle_nodes_nav)"/>
        </include>
    </group>

</launch>
