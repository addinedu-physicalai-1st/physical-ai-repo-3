<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="mapv5_moca">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.8 0.8</background>
      <grid>false</grid>
    </scene>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-41.545 -0.374 18 0 1.5708 0</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>250</far>
        </camera_clip>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <sky>true</sky>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/mapv5_moca/control</service>
        <stats_topic>/world/mapv5_moca/stats</stats_topic>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
        <topic>/world/mapv5_moca/stats</topic>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>-41.545 -0.374 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.09</constant>
        <linear>0.001</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 -0.3 -0.9</direction>
    </light>

    <light type="point" name="lamp_main_1">
      <pose>-48.625 -0.025 2.5 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="lamp_main_2">
      <pose>-39.625 2.975 2.5 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ============================================================
         스탠드형 전등 (floor lamp) — 카페 분위기 보강 (2026-05-16)
         모델: models/floor_lamp (베이스 + 폴 + 갓 + 갓 안 warm point light)
         picker: scripts/place_furniture_picker.py 의 L01~L05 항목
         ============================================================ -->
    <include>
      <name>L01</name>
      <uri>model://floor_lamp</uri>
      <pose>-35.300 0.526 0 0 0 0</pose>
    </include>

    <!-- floor 19.55 x 12.50 m, light gray dotted grid PBR texture -->
    <include>
      <uri>model://floor_grid</uri>
      <pose>-41.545 -0.374 -0.01 0 0 0</pose>
    </include>

    <include>
      <uri>model://mapv5</uri>
      <pose>-51.320 -6.624 0 0 0 0</pose>
    </include>

    <!-- ============================================================
         moca cafe furniture — config/cafe_layout.yaml 동기화 (2026-05-15)
         원본: scripts/place_furniture_picker.py 로 mocamap 위에 배치
         2026-05-15: kiosk 신규 추가 + 가구 좌표 picker YAML 재동기화
         vicpinky_home: 모델 미신설 — 현재 spawn pose placeholder 만 (후속 Task #3)
         ============================================================ -->

    <!-- bar_counter (yaml: prep_station) - 카운터 + OpenARM 베이스 -->
    <include>
      <name>bar_counter</name>
      <uri>model://bar_counter</uri>
      <pose>-36.070 2.793 0 0 0 3.142</pose>
    </include>

    <!-- OpenARM - bar_counter 옆, floor 위 직립 (z=0.89 = 카운터 상판 위) -->
    <include>
      <name>open_arm</name>
      <uri>model://open_arm</uri>
      <pose>-36.420 3.276 0 0 0 3.142</pose>
    </include>

    <!-- kiosk - 셀프 주문 단말 (+x 방향 = 화면면, yaml 동기화) -->
    <include>
      <name>kiosk</name>
      <uri>model://kiosk</uri>
      <pose>-35.520 3.409 0 0 0 -1.571</pose>
    </include>

    <!-- vicpinky_home - 모델 미신설, 좌표만 기록 (후속: dock plate 모델)
         pose: x=-36.920 y=2.843 yaw=-1.570
    -->

    <!-- 고객 테이블 T01~T05 - cafe_layout.yaml (yaw=0 통일, waypoint heading 후속 도출) -->
    <include>
      <name>T01</name>
      <uri>model://cafe_table</uri>
      <pose>-36.337 0.526 0 0 0 0</pose>
    </include>
    <include>
      <name>T02</name>
      <uri>model://cafe_table</uri>
      <pose>-41.037 0.243 0 0 0 0</pose>
    </include>
    <include>
      <name>T03</name>
      <uri>model://cafe_table</uri>
      <pose>-41.037 -0.574 0 0 0 0</pose>
    </include>
    <include>
      <name>T04</name>
      <uri>model://cafe_table</uri>
      <pose>-44.903 0.243 0 0 0 0</pose>
    </include>
    <include>
      <name>T05</name>
      <uri>model://cafe_table</uri>
      <pose>-44.903 -0.507 0 0 0 0</pose>
    </include>

    <!-- 광고 배너 B01~B04 — roll-up 자립 (+x = 광고면). cafe_layout.yaml banners 섹션 동기화 -->
    <include>
      <name>B01</name>
      <uri>model://banner</uri>
      <pose>-38.053 3.959 0 0 0 -1.571</pose>
    </include>
    <include>
      <name>B02</name>
      <uri>model://banner</uri>
      <pose>-35.787 3.943 0 0 0 -1.571</pose>
    </include>
    <include>
      <name>B03</name>
      <uri>model://banner</uri>
      <pose>-41.353 2.759 0 0 0 -1.571</pose>
    </include>
    <include>
      <name>B04</name>
      <uri>model://banner</uri>
      <pose>-44.387 2.776 0 0 0 -1.571</pose>
    </include>

    <!-- 스탠드형 전등 추가 L02~L03 — picker 배치 동기화 (L01 은 위에 별도) -->
    <include>
      <name>L02</name>
      <uri>model://floor_lamp</uri>
      <pose>-40.103 2.726 0 0 0 3.142</pose>
    </include>
    <include>
      <name>L03</name>
      <uri>model://floor_lamp</uri>
      <pose>-42.937 0.376 0 0 0 3.142</pose>
    </include>

    <!-- 분재 P01~P05 — picker 배치 동기화. cafe_layout.yaml plants 섹션 -->
    <include>
      <name>P01</name>
      <uri>model://bonsai_tree</uri>
      <pose>-39.387 2.743 0 0 0 3.142</pose>
    </include>
    <include>
      <name>P02</name>
      <uri>model://bonsai_tree</uri>
      <pose>-46.237 2.726 0 0 0 3.142</pose>
    </include>
    <include>
      <name>P03</name>
      <uri>model://bonsai_tree</uri>
      <pose>-47.170 -1.707 0 0 0 3.142</pose>
    </include>
    <include>
      <name>P04</name>
      <uri>model://bonsai_tree</uri>
      <pose>-35.120 -0.857 0 0 0 3.142</pose>
    </include>
    <include>
      <name>P05</name>
      <uri>model://bonsai_tree</uri>
      <pose>-36.937 3.976 0 0 0 3.142</pose>
    </include>

  </world>
</sdf>
