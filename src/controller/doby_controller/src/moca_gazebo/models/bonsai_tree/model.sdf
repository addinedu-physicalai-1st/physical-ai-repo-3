<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <model name="bonsai_tree">
    <static>true</static>
    <!-- 카페 분재. 도자기 화분(d0.30) + 흙 + 줄기 + 잎 클러스터 3개.
         total height ~0.50m. 바닥/테이블 올림 모두 가능 (z=0 floor 기준). -->

    <!-- 화분: cylinder d0.30 h0.20, 베이지 도자기 -->
    <link name="pot">
      <pose>0 0 0.100 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.150</radius><length>0.200</length></cylinder></geometry>
        <material>
          <ambient>0.45 0.40 0.32 1</ambient>
          <diffuse>0.85 0.78 0.62 1</diffuse>
          <specular>0.30 0.28 0.22 1</specular>
        </material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.150</radius><length>0.200</length></cylinder></geometry>
      </collision>
    </link>

    <!-- 흙: cylinder d0.28 h0.02, 화분 상단 -->
    <link name="soil">
      <pose>0 0 0.210 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.140</radius><length>0.020</length></cylinder></geometry>
        <material>
          <ambient>0.20 0.13 0.08 1</ambient>
          <diffuse>0.30 0.20 0.12 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- 줄기: cylinder d0.04 h0.20, 화분 위 -->
    <link name="trunk">
      <pose>0 0 0.320 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.020</radius><length>0.200</length></cylinder></geometry>
        <material>
          <ambient>0.25 0.16 0.08 1</ambient>
          <diffuse>0.40 0.26 0.12 1</diffuse>
          <specular>0.10 0.08 0.05 1</specular>
        </material>
      </visual>
    </link>

    <!-- 잎 클러스터 3개 — 짙은 녹색 sphere -->
    <link name="foliage_main">
      <pose>0 0 0.440 0 0 0</pose>
      <visual name="v">
        <geometry><sphere><radius>0.110</radius></sphere></geometry>
        <material>
          <ambient>0.10 0.25 0.10 1</ambient>
          <diffuse>0.20 0.50 0.18 1</diffuse>
          <specular>0.10 0.15 0.08 1</specular>
        </material>
      </visual>
    </link>
    <link name="foliage_left">
      <pose>-0.080 0.040 0.400 0 0 0</pose>
      <visual name="v">
        <geometry><sphere><radius>0.080</radius></sphere></geometry>
        <material>
          <ambient>0.10 0.22 0.10 1</ambient>
          <diffuse>0.22 0.55 0.20 1</diffuse>
          <specular>0.10 0.15 0.08 1</specular>
        </material>
      </visual>
    </link>
    <link name="foliage_right">
      <pose>0.080 -0.040 0.405 0 0 0</pose>
      <visual name="v">
        <geometry><sphere><radius>0.075</radius></sphere></geometry>
        <material>
          <ambient>0.10 0.22 0.10 1</ambient>
          <diffuse>0.22 0.52 0.18 1</diffuse>
          <specular>0.10 0.15 0.08 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
