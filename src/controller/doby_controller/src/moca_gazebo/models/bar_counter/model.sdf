<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <model name="bar_counter">
    <static>true</static>
    <!-- bar counter - 1.2m x 0.6m x 0.35m. white body + white top + pink accent strip -->

    <!-- top: 1.2x0.6x0.03, top surface z=0.35. cream white -->
    <link name="counter_top">
      <pose>0 0 0.335 0 0 0</pose>
      <visual name="top_visual">
        <geometry>
          <box><size>1.2 0.6 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.97 0.96 0.94 1</ambient>
          <diffuse>1.0 0.99 0.97 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <collision name="top_collision">
        <geometry>
          <box><size>1.2 0.6 0.03</size></box>
        </geometry>
      </collision>
    </link>

    <!-- body: 1.16x0.56x0.32. cream white -->
    <link name="counter_body">
      <pose>0 0 0.16 0 0 0</pose>
      <visual name="body_visual">
        <geometry>
          <box><size>1.16 0.56 0.32</size></box>
        </geometry>
        <material>
          <ambient>0.94 0.93 0.91 1</ambient>
          <diffuse>0.99 0.98 0.96 1</diffuse>
          <specular>0.18 0.18 0.18 1</specular>
        </material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box><size>1.16 0.56 0.32</size></box>
        </geometry>
      </collision>
    </link>

    <!-- accent strip - 1.2x0.02x0.04, front edge. deeper pink for contrast against body -->
    <link name="pink_strip">
      <pose>0 -0.305 0.335 0 0 0</pose>
      <visual name="strip_visual">
        <geometry>
          <box><size>1.2 0.02 0.04</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.20 0.45 1</ambient>
          <diffuse>1.0 0.30 0.55 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <emissive>0.05 0.02 0.03 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
