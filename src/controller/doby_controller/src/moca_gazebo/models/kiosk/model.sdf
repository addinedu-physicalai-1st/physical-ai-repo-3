<?xml version="1.0" encoding="utf-8"?>
<!--
  kiosk — moca 카페 셀프 주문 키오스크.
  footprint 0.50 x 0.40 m (picker 와 일치), 전체 높이 1.00 m.
  +x 방향 = 화면(고객 응대 면). 화면은 세로형 portrait (W 0.26 × H 0.46, ≈9:16).
  구조: base slab + vertical column + 상단 portrait housing + screen face + 양옆 베젤 글로우.
  2026-05-15: 듀얼 패널(v5) 롤백 — 단일 portrait 화면 (v4) 복원.
-->
<sdf version="1.7">
  <model name="kiosk">
    <static>true</static>

    <!-- 1) 베이스 슬랩 -->
    <link name="base">
      <pose>0 0 0.040 0 0 0</pose>
      <visual name="base_visual">
        <geometry>
          <box><size>0.500 0.400 0.080</size></box>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.12 1</ambient>
          <diffuse>0.18 0.18 0.20 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <collision name="base_collision">
        <geometry>
          <box><size>0.500 0.400 0.080</size></box>
        </geometry>
      </collision>
    </link>

    <!-- 2) 수직 컬럼 -->
    <link name="column">
      <pose>0 0 0.290 0 0 0</pose>
      <visual name="column_visual">
        <geometry>
          <box><size>0.080 0.300 0.420</size></box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.20 0.20 0.22 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>
      <collision name="column_collision">
        <geometry>
          <box><size>0.080 0.300 0.420</size></box>
        </geometry>
      </collision>
    </link>

    <!-- 3) 상단 하우징 — portrait 디스플레이 외곽 (top z=1.0) -->
    <link name="housing">
      <pose>0 0 0.750 0 0 0</pose>
      <visual name="housing_visual">
        <geometry>
          <box><size>0.060 0.300 0.500</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.10 1</ambient>
          <diffuse>0.15 0.15 0.17 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <collision name="housing_collision">
        <geometry>
          <box><size>0.060 0.300 0.500</size></box>
        </geometry>
      </collision>
    </link>

    <!-- 4) 디스플레이면 — 세로형 단색 다크 네이비 -->
    <link name="screen">
      <pose>0.033 0 0.750 0 0 0</pose>
      <visual name="screen_visual">
        <geometry>
          <box><size>0.005 0.260 0.460</size></box>
        </geometry>
        <material>
          <ambient>0.02 0.04 0.10 1</ambient>
          <diffuse>0.04 0.10 0.22 1</diffuse>
          <specular>0.40 0.40 0.50 1</specular>
          <emissive>0.05 0.15 0.30 1</emissive>
        </material>
      </visual>
    </link>

    <!-- 5) 화면 베젤 — 좌우 시안 글로우 스트립 (portrait 높이 0.46 매칭) -->
    <link name="bezel_left">
      <pose>0.033 0.140 0.750 0 0 0</pose>
      <visual name="bezel_l_visual">
        <geometry>
          <box><size>0.006 0.012 0.480</size></box>
        </geometry>
        <material>
          <ambient>0.00 0.30 0.45 1</ambient>
          <diffuse>0.00 0.50 0.75 1</diffuse>
          <specular>0.20 0.40 0.50 1</specular>
          <emissive>0.00 0.80 1.00 1</emissive>
        </material>
      </visual>
    </link>
    <link name="bezel_right">
      <pose>0.033 -0.140 0.750 0 0 0</pose>
      <visual name="bezel_r_visual">
        <geometry>
          <box><size>0.006 0.012 0.480</size></box>
        </geometry>
        <material>
          <ambient>0.00 0.30 0.45 1</ambient>
          <diffuse>0.00 0.50 0.75 1</diffuse>
          <specular>0.20 0.40 0.50 1</specular>
          <emissive>0.00 0.80 1.00 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
