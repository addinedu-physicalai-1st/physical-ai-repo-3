<?xml version='1.0' encoding='utf-8'?>
<!--
  floor_grid — 19.55 x 12.50 m 카페 바닥.
  2026-05-15: 단일 stretched box → OBJ 메쉬 (UV 1 m 타일) 전환.
              bottom.png 가 1 m 당 한 번 반복되어 stretch 없이 약 20x12 회 타일링.
  충돌은 가벼운 box 그대로 유지.
-->
<sdf version="1.7">
  <model name="floor_grid">
    <static>true</static>
    <link name="floor_link">
      <visual name="floor_visual">
        <geometry>
          <mesh>
            <uri>model://floor_grid/meshes/floor_plane.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.99 0.99 0.99 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://floor_grid/textures/bottom.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="floor_collision">
        <geometry>
          <box>
            <size>19.55 12.50 0.02</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
