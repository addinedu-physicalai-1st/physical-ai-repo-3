<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <model name="open_arm">
    <static>true</static>
    <!-- OpenARM dual-arm barista robot - referencing images/openarm.png.
         Style: aluminum twin columns + pink mid strips + gray shoulder block +
                hanging arms with metal grippers. Floor-standing.
         2026-05-15: 모든 Z (pose + size) x1.5 스케일. 총높이 0.55m → 0.825m. -->

    <!-- base pad - dark gray, 0.20 x 0.20 x 0.06 -->
    <link name="base_pad">
      <pose>0 0 0.030 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.20 0.20 0.06</size></box></geometry>
        <material>
          <ambient>0.22 0.22 0.24 1</ambient>
          <diffuse>0.30 0.30 0.33 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>
      <collision name="c"><geometry><box><size>0.20 0.20 0.06</size></box></geometry></collision>
    </link>

    <!-- LEFT column - aluminum silver, 0.04 x 0.04 x 0.63 -->
    <link name="col_left">
      <pose>-0.07 0 0.375 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.04 0.04 0.63</size></box></geometry>
        <material>
          <ambient>0.65 0.65 0.68 1</ambient>
          <diffuse>0.80 0.80 0.83 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
    </link>
    <!-- RIGHT column -->
    <link name="col_right">
      <pose>0.07 0 0.375 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.04 0.04 0.63</size></box></geometry>
        <material>
          <ambient>0.65 0.65 0.68 1</ambient>
          <diffuse>0.80 0.80 0.83 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
    </link>

    <!-- pink mid strips - 3 horizontal accents between columns -->
    <link name="strip_low">
      <pose>0 0 0.240 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.14 0.012 0.06</size></box></geometry>
        <material>
          <ambient>0.95 0.40 0.60 1</ambient>
          <diffuse>1.0 0.55 0.72 1</diffuse>
          <emissive>0.06 0.02 0.04 1</emissive>
        </material>
      </visual>
    </link>
    <link name="strip_mid">
      <pose>0 0 0.390 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.14 0.012 0.06</size></box></geometry>
        <material>
          <ambient>0.95 0.40 0.60 1</ambient>
          <diffuse>1.0 0.55 0.72 1</diffuse>
          <emissive>0.06 0.02 0.04 1</emissive>
        </material>
      </visual>
    </link>
    <link name="strip_high">
      <pose>0 0 0.540 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.14 0.012 0.06</size></box></geometry>
        <material>
          <ambient>0.95 0.40 0.60 1</ambient>
          <diffuse>1.0 0.55 0.72 1</diffuse>
          <emissive>0.06 0.02 0.04 1</emissive>
        </material>
      </visual>
    </link>

    <!-- shoulder block - dark gray top housing, 0.22 x 0.10 x 0.12 -->
    <link name="shoulder_block">
      <pose>0 0 0.750 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.22 0.10 0.12</size></box></geometry>
        <material>
          <ambient>0.28 0.28 0.30 1</ambient>
          <diffuse>0.42 0.42 0.45 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      <collision name="c"><geometry><box><size>0.22 0.10 0.12</size></box></geometry></collision>
    </link>

    <!-- PinkLAB logo accent on shoulder - small pink dot front -->
    <link name="shoulder_logo">
      <pose>0 -0.051 0.750 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.015</radius><length>0.005</length></cylinder></geometry>
        <pose>0 0 0 1.5708 0 0</pose>
        <material>
          <ambient>0.95 0.40 0.60 1</ambient>
          <diffuse>1.0 0.55 0.72 1</diffuse>
          <emissive>0.10 0.04 0.06 1</emissive>
        </material>
      </visual>
    </link>

    <!-- LEFT arm - hanging from shoulder, slanted forward -->
    <link name="left_shoulder_joint">
      <pose>-0.10 0 0.720 0 0 0</pose>
      <visual name="v">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.30 0.30 0.32 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="left_upper">
      <pose>-0.10 0.02 0.600 0 -0.35 0</pose>
      <visual name="v">
        <geometry><box><size>0.035 0.035 0.27</size></box></geometry>
        <material>
          <ambient>0.65 0.65 0.68 1</ambient>
          <diffuse>0.80 0.80 0.83 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
    </link>
    <link name="left_elbow">
      <pose>-0.16 0.04 0.465 0 0 0</pose>
      <visual name="v">
        <geometry><sphere><radius>0.022</radius></sphere></geometry>
        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.30 0.30 0.32 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="left_forearm">
      <pose>-0.17 0.06 0.345 0 -1.2 0</pose>
      <visual name="v">
        <geometry><box><size>0.030 0.030 0.24</size></box></geometry>
        <material>
          <ambient>0.65 0.65 0.68 1</ambient>
          <diffuse>0.80 0.80 0.83 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
    </link>
    <link name="left_gripper">
      <pose>-0.24 0.08 0.225 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.05 0.04 0.06</size></box></geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
    </link>

    <!-- RIGHT arm - mirror -->
    <link name="right_shoulder_joint">
      <pose>0.10 0 0.720 0 0 0</pose>
      <visual name="v">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.30 0.30 0.32 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="right_upper">
      <pose>0.10 0.02 0.600 0 -0.35 0</pose>
      <visual name="v">
        <geometry><box><size>0.035 0.035 0.27</size></box></geometry>
        <material>
          <ambient>0.65 0.65 0.68 1</ambient>
          <diffuse>0.80 0.80 0.83 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
    </link>
    <link name="right_elbow">
      <pose>0.16 0.04 0.465 0 0 0</pose>
      <visual name="v">
        <geometry><sphere><radius>0.022</radius></sphere></geometry>
        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.30 0.30 0.32 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="right_forearm">
      <pose>0.17 0.06 0.345 0 -1.2 0</pose>
      <visual name="v">
        <geometry><box><size>0.030 0.030 0.24</size></box></geometry>
        <material>
          <ambient>0.65 0.65 0.68 1</ambient>
          <diffuse>0.80 0.80 0.83 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
    </link>
    <link name="right_gripper">
      <pose>0.24 0.08 0.225 0 0 0</pose>
      <visual name="v">
        <geometry><box><size>0.05 0.04 0.06</size></box></geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
