<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <model name="floor_lamp">
    <static>true</static>
    <!-- 스탠드형 카페 전등. 베이스 + 브래스 폴 + 따뜻한 갓 + 갓 안 point light.
         total height ~1.74m. collision: 베이스 + 폴만. -->

    <link name="base">
      <pose>0 0 0.020 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.200</radius><length>0.040</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.07 0.05 1</ambient>
          <diffuse>0.18 0.12 0.08 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.200</radius><length>0.040</length></cylinder></geometry>
      </collision>
    </link>

    <link name="pole">
      <pose>0 0 0.740 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.025</radius><length>1.400</length></cylinder></geometry>
        <material>
          <ambient>0.30 0.22 0.10 1</ambient>
          <diffuse>0.55 0.42 0.18 1</diffuse>
          <specular>0.60 0.55 0.40 1</specular>
        </material>
      </visual>
      <collision name="c">
        <geometry><cylinder><radius>0.025</radius><length>1.400</length></cylinder></geometry>
      </collision>
    </link>

    <link name="shade">
      <pose>0 0 1.590 0 0 0</pose>
      <visual name="v">
        <geometry><cylinder><radius>0.200</radius><length>0.300</length></cylinder></geometry>
        <material>
          <ambient>0.55 0.40 0.20 1</ambient>
          <diffuse>0.95 0.78 0.45 1</diffuse>
          <specular>0.20 0.18 0.10 1</specular>
          <emissive>0.30 0.22 0.10 1</emissive>
        </material>
      </visual>
      <light type="point" name="bulb">
        <pose>0 0 0.050 0 0 0</pose>
        <diffuse>1.00 0.85 0.60 1</diffuse>
        <specular>0.20 0.18 0.12 1</specular>
        <attenuation>
          <range>5</range>
          <constant>0.4</constant>
          <linear>0.20</linear>
          <quadratic>0.10</quadratic>
        </attenuation>
        <cast_shadows>false</cast_shadows>
      </light>
    </link>
  </model>
</sdf>
