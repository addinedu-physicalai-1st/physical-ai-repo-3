<?xml version="1.0"?>
<!--
  vicpinky_moca_core.xacro
  vicpinky_description/urdf/robot_core.xacro 의 moca-측 사본.
  변경 (2026-05-15): 실 vicpinky 의 front-axle 디자인 정합
    - wheel_x_offset = 0.20 m (구동 휠을 chassis 전면 쪽으로 이동)
    - base_link → base_footprint joint origin 의 X 를 -wheel_x_offset 만큼 이동
      → 회전 중심 (base_footprint) = 휠축 위치 정확 정렬
    - 캐스터: 4개 (FL/FR/RL/RR) → 후방 2개 (RL/RR) 만 유지
  외부 패키지 vicpinky_description 무수정. inertial_macros 만 share 참조.
-->
<robot name="vicpinky" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="namespace" default=""/>
    <xacro:property name="prefix" value="$(arg namespace)"/>

    <xacro:include filename="$(find vicpinky_description)/urdf/inertial_macros.xacro"/>

    <xacro:property name="wheel_separation" value="0.4288"/>
    <!-- 휠축 X 위치 (base_link 기준). 실 vicpinky 가 앞축이므로 +값. -->
    <xacro:property name="wheel_x_offset" value="0.20"/>

    <xacro:property name="chassis_length" value="0.6"/>
    <xacro:property name="chassis_width" value="0.5"/>
    <xacro:property name="chassis_height" value="0.128"/>
    <xacro:property name="chassis_mass" value="50.0"/>
    <xacro:property name="chassis_z_offset" value="0.087"/>
    
    <xacro:property name="wheel_radius" value="0.0825"/>
    <xacro:property name="wheel_thickness" value="0.05"/>
    <xacro:property name="wheel_mass" value="0.05"/>
    
    <xacro:property name="caster_wheel_radius" value="${chassis_z_offset/2}"/>
    <xacro:property name="caster_wheel_mass" value="3.0"/>
    
    <xacro:property name="caster_x_inset" value="0.056"/>  
    <xacro:property name="caster_y_inset" value="0.156"/>  
    <xacro:property name="caster_x_offset" value="${chassis_length/2 - caster_x_inset}"/>
    <xacro:property name="caster_y_offset" value="${chassis_width/2 - caster_y_inset}"/>

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>
    <material name="gray">
        <color rgba="0.2 0.2 0.2 1" />
    </material>
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>
    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>
    <material name="light_gray">
        <color rgba="0.65 0.65 0.68 1"/>
    </material>
    <material name="plate_dark">
        <color rgba="0.32 0.32 0.34 1"/>
    </material>

    <!-- ============================================================
         base_link — vicpinky 프레임 구조 (doc/image.png 참고)
         - 하단 plate + 상단 plate + 4 코너 컬럼
         - 외부 base_link.stl 메쉬 미사용 (primitive box 만)
         - collision/inertial 은 단일 bounding box (기존 호환)
         ============================================================ -->
    <xacro:property name="plate_thickness" value="0.015"/>
    <xacro:property name="column_size" value="0.030"/>
    <xacro:property name="column_inset" value="0.025"/>

    <link name="${prefix}base_link">
        <!-- 하단 plate -->
        <visual>
            <origin xyz="0 0 ${plate_thickness/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${plate_thickness}"/>
            </geometry>
            <material name="light_gray"/>
        </visual>
        <!-- 상단 plate (LiDAR/camera 마운트 면) — 살짝 어둡게 -->
        <visual>
            <origin xyz="0 0 ${chassis_height - plate_thickness/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${plate_thickness}"/>
            </geometry>
            <material name="plate_dark"/>
        </visual>
        <!-- 4 코너 컬럼 — chassis 모서리 인셋 -->
        <xacro:macro name="frame_column" params="suffix x_sign y_sign">
            <visual>
                <origin xyz="${x_sign * (chassis_length/2 - column_inset)} ${y_sign * (chassis_width/2 - column_inset)} ${chassis_height/2}" rpy="0 0 0"/>
                <geometry>
                    <box size="${column_size} ${column_size} ${chassis_height - 2*plate_thickness}"/>
                </geometry>
                <material name="light_gray"/>
            </visual>
        </xacro:macro>
        <xacro:frame_column suffix="fl" x_sign="1"  y_sign="1"/>
        <xacro:frame_column suffix="fr" x_sign="1"  y_sign="-1"/>
        <xacro:frame_column suffix="rl" x_sign="-1" y_sign="1"/>
        <xacro:frame_column suffix="rr" x_sign="-1" y_sign="-1"/>

        <collision>
            <origin xyz="0 0 ${chassis_height/2-0.02}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
   
    <link name="${prefix}base_footprint"/>

    <!-- base_link X 를 -wheel_x_offset 만큼 이동 → base_footprint = 휠축 위치 정렬 -->
    <joint name="${prefix}base_link_fixed_joint" type="fixed">
        <parent link="${prefix}base_footprint"/>
        <child link="${prefix}base_link"/>
        <origin xyz="${-wheel_x_offset} 0 ${chassis_z_offset}" rpy="0 0 0"/>
    </joint>

    <joint name="${prefix}left_wheel_joint" type="continuous">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}left_wheel"/>
        <origin xyz="${wheel_x_offset} ${wheel_separation/2} -0.0048" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
            <geometry>
                <mesh filename="package://vicpinky_description/meshes/visual/wheel.stl" scale="1 1 1"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="${prefix}right_wheel_joint" type="continuous">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}right_wheel"/>
        <origin xyz="${wheel_x_offset} ${-1 * wheel_separation/2} -0.0048" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="${prefix}right_wheel">
        <visual>
            <origin xyz="0 0.0 0.0" rpy="0 ${-pi/2} 0"/>
            <geometry>
                <mesh filename="package://vicpinky_description/meshes/visual/wheel.stl" scale="1 1 1"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <xacro:macro name="caster_wheel" params="suffix x_offset y_offset">
        <joint name="${prefix}${suffix}_caster_joint" type="fixed">
            <parent link="${prefix}base_link"/>
            <child link="${prefix}${suffix}_caster"/>
            <origin xyz="${x_offset} ${y_offset} ${-chassis_z_offset + caster_wheel_radius}" rpy="0 0 0"/>
        </joint>

        <link name="${prefix}${suffix}_caster">
            <visual>
                <origin xyz="0 0 ${caster_wheel_radius}" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://vicpinky_description/meshes/visual/caster.stl" scale="1 1 1"/>
                </geometry>
                <material name="gray"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="${caster_wheel_radius}"/>
                </geometry>
            </collision>
            <xacro:inertial_sphere mass="${caster_wheel_mass}" radius="${caster_wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_sphere>
        </link>
    </xacro:macro>

    <!-- 실 vicpinky 가 앞축 + 후방 캐스터 → FL/FR 제거, RL/RR 만 유지 -->
    <xacro:caster_wheel suffix="rear_left"   x_offset="${-caster_x_offset}" y_offset="${caster_y_offset}"/>
    <xacro:caster_wheel suffix="rear_right"  x_offset="${-caster_x_offset}" y_offset="${-caster_y_offset}"/>

    <link name="${prefix}lidar_mount">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://vicpinky_description/meshes/visual/lidar.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://vicpinky_description/meshes/collision/lidar.stl" scale="1 1 1"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.110"/>
            <inertia ixx="0.000058" ixy="0" ixz="0.000005" iyy="0.000099" iyz="0" izz="0.000103"/>
        </inertial>
    </link>

    <joint name="${prefix}lidar_mount_fixed_joint" type="fixed">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}lidar_mount"/>
        <origin xyz="0.185 0.0 0.12" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}laser_link"/>

    <joint name="${prefix}laser_link_fixed_joint" type="fixed">
        <parent link="${prefix}lidar_mount"/>
        <child link="${prefix}laser_link"/>
        <origin xyz="0.0 0 0.03" rpy="0 0 ${pi}"/>
    </joint>

</robot>