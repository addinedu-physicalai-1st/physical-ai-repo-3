<?xml version='1.0' ?>
<!--
  moca_gazebo/launch/launch_mapv6.launch.xml
  mapv6 walls-only world + 로봇 spawn. launch_sim 의 world_name/spawn 단축 wrapper.

  spawn 기본값 = waypoints_mapv6_capture.yaml 의 HOME (8.3065, -5.6187, yaw -1.5675).
  좌표계는 src/moca_navigation/map/mapv6.yaml (AMCL map) 과 동일 — Nav2/waypoint 정합.

  검증 시동 (도메인99 격리):
    ROS_DOMAIN_ID=99 ROS_LOCALHOST_ONLY=1 ros2 launch moca_gazebo launch_mapv6.launch.xml
-->
<launch>
    <arg name="robot_name" default="pinky"/>

    <include file="$(find-pkg-share moca_gazebo)/launch/launch_sim.launch.xml">
        <arg name="robot_name" value="$(var robot_name)"/>
        <arg name="world_name" value="mapv6.world"/>
        <arg name="spawn_x" value="8.3065"/>
        <arg name="spawn_y" value="-5.6187"/>
        <arg name="spawn_z" value="0.1"/>
        <arg name="spawn_yaw" value="-1.5675"/>
    </include>
</launch>
