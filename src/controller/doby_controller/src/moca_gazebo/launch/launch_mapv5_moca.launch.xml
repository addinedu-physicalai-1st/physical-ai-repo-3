<?xml version='1.0' ?>
<!--
  moca_gazebo/launch/launch_mapv5_moca.launch.xml
  mapv5_moca.world — mapv5 wall + 카페 가구 (OpenARM + bar_counter + T01~T05)
  spawn: config/cafe_layout.yaml 의 pinky_spawn 좌표

  검증 시동:
    ROS_DOMAIN_ID=99 ROS_LOCALHOST_ONLY=1 ros2 launch moca_gazebo launch_mapv5_moca.launch.xml
-->
<launch>
    <arg name="robot_name" default="pinky"/>

    <include file="$(find-pkg-share moca_gazebo)/launch/launch_sim.launch.xml">
        <arg name="robot_name" value="$(var robot_name)"/>
        <arg name="world_name" value="mapv5_moca.world"/>
        <!-- 2026-05-17 (저녁) — dock vs staging 분리. sim spawn = staging (path 시작 안전).
             dock (-36.98, 2.649) 는 cafe_layout pinky_home, 후속 dock action 사용. -->
        <arg name="spawn_x" value="-36.98"/>
        <arg name="spawn_y" value="2.0"/>
        <arg name="spawn_z" value="0.05"/>
        <arg name="spawn_yaw" value="-1.571"/>
    </include>
</launch>
