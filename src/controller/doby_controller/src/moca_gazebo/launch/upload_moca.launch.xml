<?xml version='1.0'?>
<!--
  moca_gazebo/launch/upload_moca.launch.xml
  vicpinky_description/launch/upload.launch.xml 의 moca-specific 사본.
  xacro 만 vicpinky_moca.urdf.xacro (riser 추가) 로 교체. 외부 패키지는 그대로.
-->
<launch>
    <arg name="prefix" default=""/>
    <arg name="use_sim_time" default="True"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" name='robot_state_publisher' output='screen' namespace="$(var prefix)">
        <param name="robot_description" value="$(command 'xacro $(find-pkg-share moca_gazebo)/urdf/vicpinky_moca.urdf.xacro namespace:=$(var prefix)')"/>
        <param name='use_sim_time' value='$(var use_sim_time)'/>
    </node>
</launch>
