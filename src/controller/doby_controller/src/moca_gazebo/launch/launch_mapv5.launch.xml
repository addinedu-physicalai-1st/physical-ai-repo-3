<?xml version='1.0' ?>
<!--
  moca_gazebo/launch/launch_mapv5.launch.xml
  Source: maps/mapv5_config/launch_mapv5.launch.xml (사용자 제공, 사본 + path patch)

  변경 (2026-05-14):
   - find-pkg-share vicpinky_gazebo → moca_gazebo (자체 참조)
   - launch_sim 의 default 가 이미 mapv5 라 본 launch 는 spawn 위치 명시 단축용.

  검증 시동:
    ROS_DOMAIN_ID=99 ROS_LOCALHOST_ONLY=1 ros2 launch moca_gazebo launch_mapv5.launch.xml
-->
<launch>
    <arg name="robot_name" default="pinky"/>

    <include file="$(find-pkg-share moca_gazebo)/launch/launch_sim.launch.xml">
        <arg name="robot_name" value="$(var robot_name)"/>
        <arg name="world_name" value="mapv5.world"/>
        <arg name="spawn_x" value="-40.02"/>
        <arg name="spawn_y" value="-0.47"/>
        <arg name="spawn_z" value="0.3"/>
        <arg name="spawn_yaw" value="0.0"/>
    </include>
</launch>
