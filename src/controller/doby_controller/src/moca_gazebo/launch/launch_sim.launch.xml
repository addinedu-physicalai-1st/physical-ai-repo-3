<?xml version='1.0' ?>
<!--
  moca_gazebo/launch/launch_sim.launch.xml
  Source: vicpinky_gazebo/launch/launch_sim.launch.xml (PinkLAB 원본 동결, 사본 + patch)

  변경 (P-C, 2026-05-14):
   - find-pkg-share 를 moca_gazebo 자체 참조 (worlds/, params/, models/)
   - vicpinky_description 의 robot URDF/xacro 는 그대로 의존 (PinkLAB 원본 사용)
   - spawn_x/y/z/yaw arg 추가 — default 는 mapv5 자유공간 권장 좌표
   - GZ_SIM_RESOURCE_PATH 에 moca_gazebo/models 우선, vicpinky_gazebo/models 도 fallback (factory_L1 등 원본 자산 호환)

  검증 시동:
    ROS_DOMAIN_ID=99 ROS_LOCALHOST_ONLY=1 ros2 launch moca_gazebo launch_sim.launch.xml
-->
<launch>
    <arg name="robot_name" default="pinky"/>
    <arg name="world_name" default="mapv5.world"/>
    <arg name="world" default="$(find-pkg-share moca_gazebo)/worlds/$(var world_name)"/>
    <arg name="bridge_params" default="$(find-pkg-share moca_gazebo)/params/pinky_bridge.yaml"/>

    <!-- spawn 위치 (mapv5 자유공간 권장. mapv5 mesh_info.txt 의 spawn_x=-38.81, spawn_y=-2.13 또는 launch_mapv5 의 -40.02, -0.47). default 는 launch_mapv5 와 동일하게 안전한 자유공간으로 박음. -->
    <arg name="spawn_x" default="-40.02"/>
    <arg name="spawn_y" default="-0.47"/>
    <arg name="spawn_z" default="0.3"/>
    <arg name="spawn_yaw" default="0.0"/>

    <!-- GZ_SIM_RESOURCE_PATH: moca_gazebo/models (mapv5) + vicpinky_description/../ (URDF asset).
         vicpinky_gazebo 는 COLCON_IGNORE 상태이므로 참조 제거 (find-pkg-share 가 패키지 없으면 launch 즉시 fail). -->
    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share moca_gazebo)/models:$(find-pkg-share vicpinky_description)/../:$(env HOME)/.gazebo/models"/>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name='gz_args' value='-r -s -v4, $(var world)'/>
        <arg name='on_exit_shutdown' value='true'/>
    </include>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name='gz_args' value='-g -v4 '/>
    </include>

    <!-- moca 전용 upload — vicpinky_description 의 robot.urdf.xacro 를 wrap + body_riser 추가
         (외부 패키지 vicpinky_description 직접 수정 X) -->
    <include file="$(find-pkg-share moca_gazebo)/launch/upload_moca.launch.xml">
        <arg name='use_sim_time' value='True'/>
    </include>

    <node pkg="ros_gz_sim" exec="create" name='create' output='screen'
          args="-name $(var robot_name) -topic robot_description
                -x $(var spawn_x) -y $(var spawn_y) -z $(var spawn_z) -Y $(var spawn_yaw)">
        <param name='use_sim_time' value='True'/>
    </node>

    <node pkg="ros_gz_bridge" exec="parameter_bridge" name='parameter_bridge' output='screen' args="--ros-args -p config_file:=$(var bridge_params)"/>
    <node pkg="ros_gz_image" exec="image_bridge" name='image_bridge' output='screen' args="/camera/image_raw"/>
    <node pkg="ros_gz_image" exec="image_bridge" name='image_bridge' output='screen' args="/camera"/>
</launch>
