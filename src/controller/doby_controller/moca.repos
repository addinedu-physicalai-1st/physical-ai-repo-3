# moca.repos — 외부 저장소 복원용 (vcs tool)
#
# 사용법:
#   sudo apt install python3-vcstool   # 한 번만
#   cd ~/moca
#   vcs import src < moca.repos
#
# vic_pinky는 PinkLAB 공식 저장소 사용.
# 본 프로젝트의 로컬 변경사항(BatteryState 추가 등)은
# feature/dobi-npc-base 브랜치에 보존되어 있음.
# main 브랜치는 PinkLAB 원본 그대로 (51da1b1).

repositories:
  shared/vic_pinky:
    type: git
    url: https://github.com/pinklab-art/vic_pinky.git
    version: feature/dobi-npc-base   # 본 프로젝트 작업 브랜치
