<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>controller_launch</name>
  <version>0.0.0</version>
  <description>XML launch package for starting controller ROS packages.</description>
  <maintainer email="robo@example.com">robo</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>cooking_controller</exec_depend>
  <exec_depend>dual_arm_controller</exec_depend>
  <exec_depend>interaction_controller</exec_depend>
  <exec_depend>serving_controller</exec_depend>
  <exec_depend>single_arm_controller</exec_depend>
  <exec_depend>table_monitor_controller</exec_depend>
  <exec_depend>vic_pinky_controller</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
