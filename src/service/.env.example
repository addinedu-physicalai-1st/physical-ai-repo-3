# docker-compose.operation.yml 용 환경변수 예시.
# 운영 PC: cp .env.example .env 후 아래 값 채우면 web_service 가 HTTPS 로 종단.
# 다른 로컬 (폰 마이크 데모 불필요): 비워두면 HTTP 로 동작.
#
# 인증서 발급 예 (mkcert):
#   cd src/service/certs
#   mkcert -cert-file cert.pem -key-file key.pem <host-ip> localhost 127.0.0.1
#
# 컨테이너 안 경로 기준. 호스트의 ./certs 가 /certs 로 mount 됨.
WEB_SERVICE_SSL_CERT=/certs/cert.pem
WEB_SERVICE_SSL_KEY=/certs/key.pem
